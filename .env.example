NEXT_PUBLIC_API_URL=https://dev.fanith.com/api/v1/

# Shared secret for POST /api/revalidate-player, which fanith-service calls when
# an admin publishes or unpublishes a player's Fan Pedia page so the cached page
# is dropped immediately rather than up to an hour later.
# Must match WEBSITE_REVALIDATE_SECRET in fanith-service. Server-side only —
# do NOT prefix with NEXT_PUBLIC_. Unset = the route returns 503 and pages
# refresh on their own within the hour.
REVALIDATE_SECRET=change-this-to-a-long-random-string
