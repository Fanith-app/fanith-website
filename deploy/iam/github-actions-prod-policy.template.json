{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrAuthorization",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "ProdRepositoryOnly",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:CompleteLayerUpload",
        "ecr:DescribeImages",
        "ecr:DescribeImageScanFindings",
        "ecr:DescribeRepositories",
        "ecr:InitiateLayerUpload",
        "ecr:PutImage",
        "ecr:UploadLayerPart"
      ],
      "Resource": "arn:aws:ecr:ap-south-1:735395976490:repository/fanith-website-prod"
    },
    {
      "Sid": "ProdClusterRead",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeClusters",
        "ecs:ListTasks"
      ],
      "Resource": "${ECS_CLUSTER_ARN}"
    },
    {
      "Sid": "ProdServiceReadUpdate",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeServices",
        "ecs:UpdateService"
      ],
      "Resource": "${ECS_SERVICE_ARN}"
    },
    {
      "Sid": "ProdTaskRead",
      "Effect": "Allow",
      "Action": "ecs:DescribeTasks",
      "Resource": "${ECS_TASK_ARN_PATTERN}"
    },
    {
      "Sid": "ProdTaskDefinitionRead",
      "Effect": "Allow",
      "Action": "ecs:DescribeTaskDefinition",
      "Resource": "${ECS_TASK_DEFINITION_ARN_PATTERN}"
    },
    {
      "Sid": "RegisterTaskDefinitionRequiredWildcard",
      "Effect": "Allow",
      "Action": "ecs:RegisterTaskDefinition",
      "Resource": "*"
    },
    {
      "Sid": "PassOnlyApprovedProdTaskRolesToEcs",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "${ECS_EXECUTION_ROLE_ARN}",
        "${ECS_TASK_ROLE_ARN}"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    }
  ]
}
